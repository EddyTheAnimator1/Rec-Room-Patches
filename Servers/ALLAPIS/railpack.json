{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": [
        "npm ci --omit=dev"
      ]
    }
  },
  "deploy": {
    "aptPackages": [
      "ffmpeg"
    ],
    "startCommand": "python -m uvicorn BASE:app --host 0.0.0.0 --port $PORT"
  }
}
